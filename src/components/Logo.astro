---
/**
 * Fawpearl wordmark. To use the official logo instead, add the file to
 * public/images (e.g. logo.svg) and set `logoSrc` below.
 */
interface Props {
  tone?: 'dark' | 'light';
}
const { tone = 'dark' } = Astro.props;
const logoSrc: string | null = null; // e.g. '/images/logo.svg'
---

<a class:list={['logo', `logo--${tone}`]} href="/" aria-label="Fawpearl Health Services, home">
  {
    logoSrc ? (
      <img src={logoSrc} alt="" width="180" height="48" />
    ) : (
      <>
        <svg class="logo__mark" viewBox="0 0 40 40" width="40" height="40" aria-hidden="true">
          <circle cx="20" cy="20" r="19" fill="#60cde5" />
          <circle cx="20" cy="20" r="12" fill="#14467c" />
          <circle cx="16" cy="15.5" r="4.2" fill="#ffffff" opacity=".9" />
        </svg>
        <span class="logo__text">
          <span class="logo__name">Fawpearl</span>
          <span class="logo__sub">Health Services</span>
        </span>
      </>
    )
  }
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    color: var(--color-navy-ink);
    flex: none;
  }
  .logo--light { color: #fff; }
  .logo__mark { width: 40px; height: 40px; flex: none; }
  .logo__text { display: flex; flex-direction: column; line-height: 1; }
  .logo__name { font-size: 1.45rem; font-weight: 800; letter-spacing: -0.03em; }
  .logo__sub {
    margin-top: 0.28rem;
    font-size: 0.68rem;
    font-weight: 650;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-turquoise-deep);
  }
  .logo--light .logo__sub { color: var(--color-turquoise); }
</style>
