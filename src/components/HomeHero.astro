---
import Icon from './Icon.astro';
import { site } from '../data/site';
import { firstVisit } from '../data/services';
---

<section class="hero">
  <div class="container hero__grid">
    <div class="hero__copy">
      {
        site.acceptingNewPatients && (
          <p class="hero__badge">
            <span class="hero__dot" aria-hidden="true" />
            Now accepting new patients
          </p>
        )
      }
      <h1>Virtual psychiatric care. <span class="hero__accent">Real healing.</span></h1>
      <p class="hero__lead">
        Evaluations, medication management and therapy with a board-certified Psychiatric Nurse Practitioner, from home or the
        facility where you live.
      </p>
      <div class="btn-row">
        <a class="btn btn--sun btn--lg" href="/book"><Icon name="calendar" />Book online now</a>
        <a class="btn btn--outline btn--lg" href={`tel:${site.phone.tel}`}><Icon name="phone" />{site.phone.display}</a>
      </div>
      <ul class="hero__points">
        <li><Icon name="check-circle" size={20} />No membership fees</li>
        <li><Icon name="check-circle" size={20} />Evening &amp; Saturday visits</li>
        <li><Icon name="check-circle" size={20} />Secure video</li>
      </ul>
    </div>

    <div class="hero__visual">
      <div class="hero__blob" aria-hidden="true"></div>
      <div class="hero__sun" aria-hidden="true"></div>
      <img class="hero__photo" src="/images/hero.jpg" alt="" width="760" height="950" fetchpriority="high" />
      <a class="hero__card" href={`/book?care=${firstVisit.slug}`}>
        <span class="icon-tile"><Icon name="clipboard" /></span>
        <span>
          <span class="hero__card-label">New patient? Start here</span>
          <strong>{firstVisit.name}</strong>
          <span class="hero__card-meta">${firstVisit.price} self-pay · Secure video</span>
        </span>
        <Icon name="arrow" class="hero__card-go" />
      </a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    background: linear-gradient(180deg, var(--color-sky) 0%, #f6fcfe 100%);
    padding-block: clamp(2.5rem, 6vw, 5rem) clamp(7rem, 12vw, 9rem);
  }
  .hero__grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;
  }
  .hero__copy { min-width: 0; }
  .hero__badge {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    margin: 0 0 1.25rem;
    padding: 0.45rem 0.9rem;
    border-radius: var(--radius-pill);
    background: #fff;
    box-shadow: var(--shadow-sm);
    color: var(--color-navy);
    font-size: var(--text-sm);
    font-weight: 700;
  }
  .hero__dot { width: 9px; height: 9px; border-radius: 50%; background: #22c55e; box-shadow: 0 0 0 4px rgba(34, 197, 94, 0.18); }
  .hero h1 { margin-bottom: 1.25rem; }
  .hero__accent {
    color: var(--color-navy);
    background: linear-gradient(transparent 62%, var(--color-sun) 62%, var(--color-sun) 90%, transparent 90%);
    padding-inline: 0.05em;
  }
  .hero__lead { max-width: 34rem; margin-bottom: 1.75rem; color: var(--color-muted); font-size: var(--text-lg); }
  .hero__points { display: flex; flex-wrap: wrap; gap: 0.5rem 1.4rem; margin: 1.6rem 0 0; padding: 0; list-style: none; color: var(--color-navy-ink); font-size: var(--text-sm); font-weight: 650; }
  .hero__points li { display: inline-flex; align-items: center; gap: 0.4rem; }
  .hero__points svg { color: var(--color-turquoise-deep); }

  .hero__visual { position: relative; min-width: 0; justify-self: center; width: min(100%, 460px); }
  .hero__blob {
    position: absolute;
    inset: 6% -10% -4% 8%;
    border-radius: 46% 54% 42% 58% / 52% 40% 60% 48%;
    background: var(--color-turquoise);
    opacity: 0.55;
  }
  .hero__sun {
    position: absolute;
    width: 120px;
    height: 120px;
    top: -18px;
    right: -6px;
    border-radius: 50%;
    background: var(--color-sun);
  }
  .hero__photo {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: 220px 220px var(--radius-lg) var(--radius-lg);
    box-shadow: var(--shadow-lg);
  }
  .hero__card {
    position: absolute;
    left: -12%;
    bottom: 8%;
    display: flex;
    align-items: center;
    gap: 0.85rem;
    max-width: 330px;
    padding: 1rem 1.1rem;
    border-radius: var(--radius-md);
    background: #fff;
    box-shadow: var(--shadow-md);
    color: var(--color-ink);
    text-decoration: none;
    transition: transform 0.2s ease;
  }
  .hero__card:hover { transform: translateY(-3px); }
  .hero__card > span:nth-child(2) { display: grid; gap: 0.1rem; }
  .hero__card-label { color: var(--color-turquoise-deep); font-size: var(--text-xs); font-weight: 750; letter-spacing: 0.06em; text-transform: uppercase; }
  .hero__card strong { color: var(--color-navy-ink); line-height: 1.3; }
  .hero__card-meta { color: var(--color-muted); font-size: var(--text-xs); }
  :global(.hero__card-go) { flex: none; color: var(--color-navy); }

  @media (max-width: 900px) {
    .hero__grid { grid-template-columns: 1fr; }
    .hero__visual { width: min(100%, 420px); margin-top: 1rem; }
    .hero__card { left: 50%; transform: translateX(-50%); bottom: -1.5rem; width: calc(100% - 1rem); max-width: 360px; }
    .hero__card:hover { transform: translateX(-50%) translateY(-3px); }
  }
</style>
