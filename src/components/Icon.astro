  home: '<path d="M4 11l8-7 8 7"/><path d="M6 10v10h12V10M10 20v-6h4v6"/>',
  'house-heart': '<path d="M4 11l8-7 8 7"/><path d="M6 10v10h12V10"/><path d="M12 17s-3-1.8-3-4a1.6 1.6 0 013-.8 1.6 1.6 0 013 .8c0 2.2-3 4-3 4z"/>',
  link: '<path d="M10 14a4 4 0 005.7 0l3-3a4 4 0 00-5.7-5.7l-1 1"/><path d="M14 10a4 4 0 00-5.7 0l-3 3a4 4 0 005.7 5.7l1-1"/>',
  lock: '<rect x="5" y="10" width="14" height="11" rx="2"/><path d="M8 10V7a4 4 0 018 0v3"/>',
