---
/**
 * Site header: utility bar, logo, main menu with drop-down panels,
 * Book online button and the mobile menu. Menu content lives in
 * src/data/navigation.ts.
 */
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import { mainNav, utilityNav } from '../data/navigation';
import { site, hoursText } from '../data/site';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => {
  const clean = href.split('#')[0].replace(/\/$/, '') || '/';
  return clean === '/' ? path === '/' : path === clean || path.startsWith(clean + '/');
};
const weekday = site.hours[0];
const hoursPayload = JSON.stringify({ tz: site.timezone, hours: site.hours });
---

<div class="utility">
  <div class="container utility__inner">
    <p class="utility__status" data-hours={hoursPayload}>
      {site.acceptingNewPatients && (
        <span class="utility__accepting"><span class="dot" aria-hidden="true"></span>Accepting new patients</span>
      )}
      <span class="utility__hours" data-hours-text>
        <Icon name="clock" size={16} />
        <span>{weekday.label} {hoursText(weekday)}</span>
      </span>
    </p>
    <nav class="utility__links" aria-label="Secondary">
      {utilityNav.map((l) => <a href={l.href}>{l.label}</a>)}
      <a class="utility__portal" href={site.booking.portal.url}>
        <Icon name="user" size={16} />Log in
      </a>
    </nav>
  </div>
</div>

<header class="header" data-header>
  <div class="container header__inner">
    <Logo />

    <nav class="nav" aria-label="Main">
      <ul class="nav__list">
        {
          mainNav.map((item, i) => (
            <li class="nav__item">
              {item.columns ? (
                <>
                  <button
                    class:list={['nav__trigger', { 'is-current': isCurrent(item.href) }]}
                    type="button"
                    aria-expanded="false"
                    aria-controls={`menu-panel-${i}`}
                    data-menu-trigger
                  >
                    {item.label}
                    <Icon name="chevron" size={16} />
                  </button>
                  <div class:list={['panel', { 'panel--mega': item.feature }]} id={`menu-panel-${i}`} hidden data-menu-panel>
                    <div class="panel__inner">
                      <div class="panel__columns">
                        {item.columns.map((col) => (
                          <div class="panel__col">
                            <p class="panel__heading">
                              {col.href ? <a href={col.href}>{col.heading}</a> : col.heading}
                            </p>
                            <ul>
                              {col.links.map((l) => (
                                <li>
                                  <a href={l.href}>{l.label}</a>
                                </li>
                              ))}
                            </ul>
                          </div>
                        ))}
                      </div>
                      {item.feature && (
                        <a class="panel__feature" href={item.feature.href}>
                          <span class="panel__eyebrow">{item.feature.eyebrow}</span>
                          <strong>{item.feature.title}</strong>
                          <span>{item.feature.text}</span>
                          <span class="panel__cta">
                            {item.feature.cta} <Icon name="arrow" size={18} />
                          </span>
                        </a>
                      )}
                      <a class="panel__all" href={item.href}>
                        {item.allLabel ?? `See all ${item.label.toLowerCase()}`} <Icon name="arrow" size={16} />
                      </a>
                    </div>
                  </div>
                </>
              ) : (
                <a class:list={['nav__link', { 'is-current': isCurrent(item.href) }]} href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                  {item.label}
                </a>
              )}
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="header__actions">
      <a class="header__phone" href={`tel:${site.phone.tel}`}>
        <Icon name="phone" size={18} />
        <span>{site.phone.display}</span>
      </a>
      <a class="btn btn--sun header__book" href="/book">Book online now</a>
      <button class="header__menu" type="button" aria-expanded="false" aria-controls="mobile-menu" data-mobile-toggle>
        <Icon name="menu" />
        <span class="visually-hidden">Open menu</span>
      </button>
    </div>
  </div>

  <div class="mobile" id="mobile-menu" hidden data-mobile-menu>
    <div class="mobile__head">
      <Logo />
      <button class="header__menu" type="button" data-mobile-close>
        <Icon name="close" />
        <span class="visually-hidden">Close menu</span>
      </button>
    </div>
    <nav class="mobile__nav" aria-label="Main">
      {
        mainNav.map((item) =>
          item.columns ? (
            <details class="mobile__group">
              <summary>
                {item.label}
                <Icon name="chevron" size={18} />
              </summary>
              {item.columns.map((col) => (
                <div class="mobile__col">
                  <p class="mobile__heading">{col.heading}</p>
                  {col.links.map((l) => (
                    <a href={l.href}>{l.label}</a>
                  ))}
                </div>
              ))}
              <a class="mobile__all" href={item.href}>
                {item.allLabel ?? `See all ${item.label.toLowerCase()}`}
              </a>
            </details>
          ) : (
            <a class="mobile__link" href={item.href}>
              {item.label}
            </a>
          ),
        )
      }
      <div class="mobile__utility">
        {utilityNav.map((l) => <a href={l.href}>{l.label}</a>)}
      </div>
    </nav>
    <div class="mobile__actions">
      <a class="btn btn--sun btn--lg btn--block" href="/book">Book online now</a>
      <a class="btn btn--outline btn--lg btn--block" href={`tel:${site.phone.tel}`}>
        <Icon name="phone" /> {site.phone.display}
      </a>
      <a class="btn btn--outline btn--lg btn--block" href={site.booking.portal.url}>
        <Icon name="user" /> Patient portal log in
      </a>
    </div>
  </div>
</header>

<style>
  /* Utility bar */
  .utility {
    background: var(--color-navy-deep);
    color: #d6e4f2;
    font-size: var(--text-xs);
  }
  .utility__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    min-height: 40px;
    flex-wrap: wrap;
  }
  .utility__status { display: flex; flex-wrap: wrap; align-items: center; gap: 0.35rem 1.25rem; margin: 0; }
  .utility__accepting { display: inline-flex; align-items: center; gap: 0.5rem; font-weight: 650; color: #fff; }
  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #4ade80;
    box-shadow: 0 0 0 4px rgba(74, 222, 128, 0.22);
  }
  .utility__hours { display: inline-flex; align-items: center; gap: 0.4rem; }
  .utility__links { display: flex; align-items: center; gap: 1.25rem; }
  .utility__links a { color: #d6e4f2; text-decoration: none; font-weight: 550; }
  .utility__links a:hover { color: #fff; text-decoration: underline; }
  .utility__portal {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding-left: 1.25rem;
    border-left: 1px solid rgba(255, 255, 255, 0.2);
    color: var(--color-sun) !important;
  }
  @media (max-width: 1080px) {
    .utility__links a:not(.utility__portal) { display: none; }
    .utility__portal { border: 0; padding: 0; }
  }
  @media (max-width: 560px) {
    .utility__hours { display: none; }
  }

  /* Header */
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-line);
  }
  .header.is-scrolled { box-shadow: var(--shadow-sm); }
  .header__inner {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    min-height: var(--header-h);
  }
  .nav { margin-inline: auto; }
  .nav__list { display: flex; align-items: center; gap: 0.25rem; margin: 0; padding: 0; list-style: none; }
  .nav__trigger,
  .nav__link {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.6rem 0.8rem;
    border: 0;
    border-radius: var(--radius-sm);
    background: none;
    color: var(--color-navy-ink);
    font: 650 var(--text-sm) / 1 var(--font-sans);
    text-decoration: none;
    cursor: pointer;
    position: relative;
    white-space: nowrap;
  }
  .nav__trigger svg { transition: transform 0.2s ease; }
  .nav__trigger[aria-expanded='true'] svg { transform: rotate(180deg); }
  .nav__trigger:hover,
  .nav__link:hover,
  .nav__trigger[aria-expanded='true'] { background: var(--color-sky); color: var(--color-navy); }
  .is-current::after {
    content: '';
    position: absolute;
    left: 0.8rem;
    right: 0.8rem;
    bottom: 0.1rem;
    height: 3px;
    border-radius: 3px;
    background: var(--color-sun);
  }

  .header__actions { display: flex; align-items: center; gap: 0.75rem; }
  .header__phone {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--color-navy);
    font-weight: 700;
    font-size: var(--text-sm);
    text-decoration: none;
    white-space: nowrap;
  }
  .header__menu {
    display: none;
    width: 46px;
    height: 46px;
    place-items: center;
    border: 1px solid var(--color-line);
    border-radius: 50%;
    background: var(--color-surface);
    color: var(--color-navy-ink);
    cursor: pointer;
  }

  /* Drop-down panels */
  .nav__item { position: static; }
  .panel {
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    background: var(--color-surface);
    border-top: 1px solid var(--color-line);
    box-shadow: var(--shadow-lg);
  }
  /* Smaller menus drop down under their own button instead of full width. */
  .nav__item:has(> .panel:not(.panel--mega)) { position: relative; }
  .panel:not(.panel--mega) {
    left: 0;
    right: auto;
    top: calc(100% + 0.5rem);
    width: 290px;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
  }
  .panel:not(.panel--mega) .panel__inner { padding: 1.25rem 1.4rem 1rem; gap: 0.75rem; }
  .panel:not(.panel--mega) .panel__columns { grid-template-columns: 1fr; }
  .panel:not(.panel--mega) .panel__all { padding-top: 0.75rem; font-size: var(--text-sm); }
  .panel__inner {
    max-width: var(--container);
    margin-inline: auto;
    padding: 2rem var(--gutter) 1.5rem;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem 2.5rem;
  }
  .panel--mega .panel__inner { grid-template-columns: 1fr 300px; }
  .panel__columns { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 2rem; }
  .panel__heading { margin: 0 0 0.75rem; font-size: var(--text-xs); font-weight: 750; letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-turquoise-deep); }
  .panel__heading a { color: inherit; text-decoration: none; }
  .panel ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.15rem; }
  .panel li a {
    display: block;
    padding: 0.45rem 0.6rem;
    margin-inline: -0.6rem;
    border-radius: 8px;
    color: var(--color-ink);
    font-weight: 550;
    text-decoration: none;
  }
  .panel li a:hover { background: var(--color-sky); color: var(--color-navy); }
  .panel__feature {
    display: grid;
    align-content: start;
    gap: 0.4rem;
    padding: 1.5rem;
    border-radius: var(--radius-md);
    background: var(--color-navy);
    color: #dbe8f5;
    text-decoration: none;
  }
  .panel__feature strong { color: #fff; font-size: var(--text-lg); line-height: 1.3; }
  .panel__eyebrow { color: var(--color-sun); font-size: var(--text-xs); font-weight: 750; letter-spacing: 0.1em; text-transform: uppercase; }
  .panel__cta { display: inline-flex; align-items: center; gap: 0.4rem; margin-top: 0.75rem; color: var(--color-sun); font-weight: 700; }
  .panel__all {
    grid-column: 1 / -1;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    justify-self: start;
    padding-top: 1rem;
    border-top: 1px solid var(--color-line);
    width: 100%;
    color: var(--color-navy);
    font-weight: 700;
    text-decoration: none;
  }

  /* Mobile menu */
  .mobile {
    position: fixed;
    inset: 0;
    z-index: 60;
    display: flex;
    flex-direction: column;
    background: var(--color-surface);
    overflow-y: auto;
    padding-bottom: env(safe-area-inset-bottom, 0px);
  }
  .mobile[hidden] { display: none; }
  .mobile__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: var(--header-h);
    padding-inline: var(--gutter);
    border-bottom: 1px solid var(--color-line);
  }
  .mobile__head .header__menu { display: grid; }
  .mobile__nav { padding: 0.5rem var(--gutter); }
  .mobile__group, .mobile__link { border-bottom: 1px solid var(--color-line); }
  .mobile__group summary,
  .mobile__link {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem 0;
    color: var(--color-navy-ink);
    font-size: var(--text-lg);
    font-weight: 700;
    text-decoration: none;
    list-style: none;
    cursor: pointer;
  }
  .mobile__group summary::-webkit-details-marker { display: none; }
  .mobile__group[open] summary svg { transform: rotate(180deg); }
  .mobile__col { display: grid; gap: 0.1rem; padding-bottom: 0.75rem; }
  .mobile__heading { margin: 0.5rem 0 0.25rem; font-size: var(--text-xs); font-weight: 750; letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-turquoise-deep); }
  .mobile__col a, .mobile__all { padding: 0.5rem 0; color: var(--color-ink); text-decoration: none; font-weight: 550; }
  .mobile__all { display: block; padding-bottom: 1rem; color: var(--color-navy); font-weight: 700; }
  .mobile__utility { display: flex; flex-wrap: wrap; gap: 0.5rem 1.25rem; padding: 1.25rem 0; }
  .mobile__utility a { color: var(--color-muted); font-weight: 600; text-decoration: none; }
  .mobile__actions { display: grid; gap: 0.6rem; padding: 0 var(--gutter) 1.5rem; margin-top: auto; }

  @media (max-width: 1440px) {
    .header__phone span { display: none; }
  }
  @media (max-width: 1100px) {
    .nav { display: none; }
    .header__actions { margin-left: auto; }
    .header__menu { display: grid; }
    .header__phone { display: none; }
  }
  @media (max-width: 480px) {
    .header__book { display: none; }
  }
</style>

<script>
  import { initHeader } from '../scripts/header';
  initHeader();
</script>
