---
import { steps } from '../data/content';
---

<ol class="steps" data-reveal>
  {
    steps.map((s, i) => (
      <li>
        <span class="steps__num">{i + 1}</span>
        <h3>{s.title}</h3>
        <p>{s.text}</p>
      </li>
    ))
  }
</ol>

<style>
  .steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1.25rem; counter-reset: step; position: relative; }
  .steps li { position: relative; padding: 1.5rem 1.25rem 1.6rem; border-radius: var(--radius-md); background: #fff; box-shadow: var(--shadow-sm); }
  .steps__num {
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    margin-bottom: 1rem;
    border-radius: 50%;
    background: var(--color-sun);
    color: var(--color-navy-ink);
    font-size: var(--text-lg);
    font-weight: 800;
  }
  .steps h3 { font-size: var(--text-lg); margin-bottom: 0.35rem; }
  .steps p { margin: 0; color: var(--color-muted); font-size: var(--text-sm); }
  @media (max-width: 1000px) { .steps { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 560px) { .steps { grid-template-columns: 1fr; } }
</style>
