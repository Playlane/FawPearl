---
import Icon from './Icon.astro';

interface Props {
  items: { q: string; a: string }[];
  openFirst?: boolean;
}
const { items, openFirst = false } = Astro.props;
---

<div class="faqs">
  {
    items.map((f, i) => (
      <details class="faq" open={openFirst && i === 0}>
        <summary>
          <span>{f.q}</span>
          <span class="faq__icon"><Icon name="plus" size={20} /></span>
        </summary>
        <p>{f.a}</p>
      </details>
    ))
  }
</div>

<style>
  .faqs { display: grid; gap: 0.75rem; }
  .faq { border: 1px solid var(--color-line); border-radius: var(--radius-md); background: #fff; padding-inline: 1.25rem; }
  .faq[open] { box-shadow: var(--shadow-sm); }
  .faq summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding-block: 1.1rem;
    color: var(--color-navy-ink);
    font-weight: 700;
    list-style: none;
    cursor: pointer;
  }
  .faq summary::-webkit-details-marker { display: none; }
  .faq__icon { display: grid; place-items: center; flex: none; width: 34px; height: 34px; border-radius: 50%; background: var(--color-sky); color: var(--color-navy); transition: transform 0.2s ease; }
  .faq[open] .faq__icon { transform: rotate(45deg); background: var(--color-sun); }
  .faq p { margin: 0; padding-bottom: 1.2rem; color: var(--color-muted); }
</style>
