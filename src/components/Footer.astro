---
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import { footerNav } from '../data/navigation';
import { site, hoursText } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer__contact">
    <div>
      <p class="footer__kicker">Questions before you book?</p>
      <p class="footer__lead">We're here to help you find the right care.</p>
    </div>
    <div class="footer__contact-actions">
      <a class="footer__pill" href={`tel:${site.phone.tel}`}><Icon name="phone" size={20} />{site.phone.display}</a>
      <a class="footer__pill" href={`mailto:${site.email}`}><Icon name="mail" size={20} />{site.email}</a>
      <a class="btn btn--sun" href="/book">Book online now</a>
    </div>
  </div>

  <div class="container footer__grid">
    <div class="footer__brand">
      <Logo tone="light" />
      <p>
        Empowering your mental wellness through compassionate, confidential virtual care. Wherever you are, expert support is a
        click away.
      </p>
      <dl class="footer__hours">
        {
          site.hours.map((row) => (
            <div>
              <dt>{row.label}</dt>
              <dd>{hoursText(row)}</dd>
            </div>
          ))
        }
      </dl>
    </div>
    {
      footerNav.map((col) => (
        <nav class="footer__col" aria-label={col.heading}>
          <p class="footer__heading">{col.heading}</p>
          <ul>
            {col.links.map((l) => (
              <li>
                <a href={l.href} {...(l.external ? { rel: 'noopener' } : {})}>
                  {l.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      ))
    }
  </div>

  <div class="container footer__base">
    <p class="footer__crisis"><Icon name="shield" size={18} /><span>{site.crisis}</span></p>
    <p>© {year} {site.name}. All rights reserved.</p>
  </div>
</footer>

<style>
  .footer { background: var(--color-navy-ink); color: #b9cbe0; font-size: var(--text-sm); }
  .footer a:not(.btn) { color: #e6eef7; text-decoration: none; }
  .footer a:not(.btn):hover { color: var(--color-sun); }

  .footer__contact {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem 2rem;
    padding-block: 2.5rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }
  .footer__kicker { margin: 0 0 0.2rem; color: var(--color-turquoise); font-weight: 700; }
  .footer__lead { margin: 0; color: #fff; font-size: var(--text-xl); font-weight: 750; letter-spacing: -0.01em; }
  .footer__contact-actions { display: flex; flex-wrap: wrap; gap: 0.75rem; align-items: center; }
  .footer__pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 48px;
    padding: 0.6rem 1.1rem;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: var(--radius-pill);
    font-weight: 650;
  }

  .footer__grid {
    display: grid;
    grid-template-columns: 1.5fr repeat(4, 1fr);
    gap: 2.5rem;
    padding-block: 3.5rem;
  }
  .footer__brand p { margin: 1.25rem 0; max-width: 32ch; }
  .footer__hours { margin: 0; display: grid; gap: 0.3rem; }
  .footer__hours div { display: flex; justify-content: space-between; gap: 1rem; max-width: 280px; }
  .footer__hours dt { color: #e6eef7; font-weight: 600; }
  .footer__hours dd { margin: 0; font-variant-numeric: tabular-nums; }
  .footer__heading {
    margin: 0 0 1rem;
    color: var(--color-turquoise);
    font-size: var(--text-xs);
    font-weight: 750;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .footer__col ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.55rem; }

  .footer__base {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem 2rem;
    padding-block: 1.75rem 2.25rem;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    font-size: var(--text-xs);
  }
  .footer__base p { margin: 0; }
  .footer__crisis { display: flex; gap: 0.5rem; max-width: 70ch; }
  .footer__crisis svg { flex: none; color: var(--color-sun); }

  @media (max-width: 1000px) {
    .footer__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .footer__brand { grid-column: 1 / -1; }
  }
  @media (max-width: 520px) {
    .footer__grid { grid-template-columns: 1fr; }
  }
</style>
