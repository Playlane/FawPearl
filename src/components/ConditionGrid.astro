---
/** "Care for every mind": a grid of conditions linking to their pages. */
import Icon from './Icon.astro';
import { conditions } from '../data/conditions';

interface Props {
  title?: string;
  intro?: string;
}
const {
  title = 'Expert care for every mind',
  intro = 'Whatever you are going through, you do not have to face it alone. Choose a topic to learn how we can help.',
} = Astro.props;
---

<section class="section">
  <div class="container">
    <header class="section-head">
      <p class="eyebrow">Conditions we treat</p>
      <h2>{title}</h2>
      <p>{intro}</p>
    </header>
    <ul class="conditions" data-reveal>
      {
        conditions.map((c) => (
          <li>
            <a class="condition" href={`/conditions/${c.slug}`}>
              <span class="condition__icon"><Icon name={c.icon} size={28} /></span>
              <span class="condition__name">{c.name}</span>
              <Icon name="arrow" size={18} class="condition__go" />
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .conditions { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1rem; }
  .condition {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    height: 100%;
    padding: 1.1rem 1.2rem;
    border: 1.5px solid var(--color-line);
    border-radius: var(--radius-md);
    background: #fff;
    color: var(--color-navy-ink);
    font-weight: 700;
    text-decoration: none;
    transition: border-color 0.15s ease, box-shadow 0.15s ease, transform 0.15s ease;
  }
  .condition:hover { border-color: var(--color-turquoise); box-shadow: var(--shadow-md); transform: translateY(-2px); }
  .condition__icon {
    display: grid;
    place-items: center;
    flex: none;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: var(--color-sun-soft);
    color: var(--color-navy);
  }
  li:nth-child(even) .condition__icon { background: var(--color-sky); }
  .condition__name { flex: 1; line-height: 1.3; }
  :global(.condition__go) { flex: none; color: var(--color-turquoise-deep); }
  @media (max-width: 1000px) { .conditions { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 520px) { .conditions { grid-template-columns: 1fr; } }
</style>
