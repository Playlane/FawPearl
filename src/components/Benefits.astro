---
import Icon from './Icon.astro';
import { benefits } from '../data/content';
---

<ul class="benefits" data-reveal>
  {
    benefits.map((b) => (
      <li>
        <span class="icon-tile"><Icon name={b.icon} /></span>
        <span>
          <strong>{b.title}</strong>
          <span>{b.text}</span>
        </span>
      </li>
    ))
  }
</ul>

<style>
  .benefits { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1.5rem; }
  .benefits li { display: flex; gap: 0.9rem; align-items: flex-start; }
  .benefits li > span:last-child { display: grid; gap: 0.2rem; }
  .benefits strong { color: var(--color-navy-ink); font-size: var(--text-base); }
  .benefits li > span:last-child > span { color: var(--color-muted); font-size: var(--text-sm); line-height: 1.5; }
  .benefits .icon-tile { background: var(--color-sun-soft); }
  @media (max-width: 1000px) { .benefits { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 560px) { .benefits { grid-template-columns: 1fr; } }
</style>
