---
import Icon from './Icon.astro';
import type { Service } from '../data/services';

interface Props {
  service: Service;
}
const { service } = Astro.props;
---

<article class="svc" data-reveal>
  <span class="icon-tile"><Icon name={service.icon} /></span>
  <h3><a href={`/services/${service.slug}`}>{service.name}</a></h3>
  <p>{service.short}</p>
  <p class="svc__foot">
    <span class="svc__price">${service.price}<small> self-pay</small></span>
    <span class="link-arrow" aria-hidden="true">Learn more <Icon name="arrow" /></span>
  </p>
</article>

<style>
  .svc {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: 1.5rem;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    background: #fff;
    transition: box-shadow 0.2s ease, transform 0.2s ease, border-color 0.2s ease;
  }
  .svc:hover { box-shadow: var(--shadow-md); transform: translateY(-3px); border-color: transparent; }
  .svc .icon-tile { margin-bottom: 0.6rem; }
  .svc h3 { margin: 0; font-size: var(--text-lg); }
  .svc h3 a { color: inherit; text-decoration: none; }
  .svc h3 a::after { content: ''; position: absolute; inset: 0; border-radius: inherit; }
  .svc p { margin: 0; color: var(--color-muted); font-size: var(--text-sm); }
  .svc__foot { display: flex; justify-content: space-between; align-items: center; margin-top: auto !important; padding-top: 1rem; }
  .svc__price { color: var(--color-navy-ink); font-size: var(--text-lg); font-weight: 800; }
  .svc__price small { color: var(--color-muted); font-size: var(--text-xs); font-weight: 600; }
</style>
