---
/** Insurance and self-pay summary with a "check my coverage" action. */
import Icon from './Icon.astro';
import { site } from '../data/site';
import { services } from '../data/services';
const lowest = Math.min(...services.map((s) => s.price));
const plans = site.insurance.plans;
---

<section class="section section--navy insurance">
  <div class="container insurance__grid">
    <div>
      <p class="eyebrow">Insurance &amp; pricing</p>
      <h2>Use your insurance or pay per visit</h2>
      <p class="insurance__lead">{site.insurance.note}</p>
      <div class="btn-row">
        <button class="btn btn--sun btn--lg" type="button" data-open-callback>Check my coverage</button>
        <a class="btn btn--light btn--lg" href="/insurance">See pricing</a>
      </div>
    </div>
    <div class="insurance__panel">
      {
        plans.length ? (
          <>
            <p class="insurance__label">Plans we accept</p>
            <ul class="insurance__plans">
              {plans.map((p) => (
                <li>{p}</li>
              ))}
            </ul>
          </>
        ) : (
          <ul class="insurance__facts">
            <li>
              <span class="insurance__big">${lowest}</span>
              <span>Visits from ${lowest} self-pay, with no membership fees</span>
            </li>
            <li>
              <Icon name="shield" size={30} />
              <span>We check your insurance coverage before your first visit</span>
            </li>
            <li>
              <Icon name="tag" size={30} />
              <span>A Good Faith Estimate of costs is available on request</span>
            </li>
          </ul>
        )
      }
    </div>
  </div>
</section>

<style>
  .insurance { position: relative; overflow: hidden; }
  .insurance::after {
    content: '';
    position: absolute;
    width: 420px;
    height: 420px;
    right: -140px;
    bottom: -220px;
    border-radius: 50%;
    background: var(--color-turquoise);
    opacity: 0.18;
  }
  .insurance__grid { position: relative; z-index: 1; display: grid; grid-template-columns: 1.1fr 0.9fr; gap: clamp(2rem, 5vw, 4rem); align-items: center; }
  .insurance__lead { color: #cfe0f2; font-size: var(--text-lg); max-width: 36rem; margin-bottom: 1.75rem; }
  .insurance__panel { padding: clamp(1.25rem, 3vw, 2rem); border-radius: var(--radius-lg); background: rgba(255, 255, 255, 0.07); border: 1px solid rgba(255, 255, 255, 0.14); }
  .insurance__facts { list-style: none; margin: 0; padding: 0; display: grid; gap: 1.25rem; }
  .insurance__facts li { display: flex; align-items: center; gap: 1rem; color: #e6eef7; font-weight: 600; }
  .insurance__facts :global(svg) { flex: none; color: var(--color-sun); }
  .insurance__big { flex: none; min-width: 64px; color: var(--color-sun); font-size: 2rem; font-weight: 800; letter-spacing: -0.03em; }
  .insurance__label { margin: 0 0 0.75rem; color: var(--color-turquoise); font-weight: 700; }
  .insurance__plans { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .insurance__plans li { padding: 0.5rem 0.9rem; border-radius: var(--radius-pill); background: #fff; color: var(--color-navy-ink); font-weight: 650; font-size: var(--text-sm); }
  @media (max-width: 860px) { .insurance__grid { grid-template-columns: 1fr; } }
</style>
