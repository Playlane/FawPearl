---
/** Header band for inner pages, with breadcrumb, title, intro and optional image. */
import Icon from './Icon.astro';

interface Props {
  title: string;
  intro?: string;
  eyebrow?: string;
  crumbs?: { label: string; href?: string }[];
  image?: string;
}
const { title, intro, eyebrow, crumbs = [], image } = Astro.props;
---

<section class:list={['page-hero', { 'page-hero--image': image }]}>
  <div class="container page-hero__grid">
    <div class="page-hero__copy">
      {
        crumbs.length > 0 && (
          <nav class="crumbs" aria-label="Breadcrumb">
            <ol>
              <li><a href="/">Home</a></li>
              {crumbs.map((c) => (
                <li>
                  <Icon name="chevron" size={14} />
                  {c.href ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}
                </li>
              ))}
            </ol>
          </nav>
        )
      }
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h1>{title}</h1>
      {intro && <p class="page-hero__intro">{intro}</p>}
      <slot />
    </div>
    {
      image && (
        <div class="page-hero__media">
          <img src={image} alt="" loading="eager" />
        </div>
      )
    }
  </div>
</section>

<style>
  .page-hero {
    position: relative;
    overflow: hidden;
    background: var(--color-sky);
    padding-block: clamp(2.5rem, 6vw, 4.5rem);
  }
  .page-hero::after {
    content: '';
    position: absolute;
    width: 360px;
    height: 360px;
    right: -120px;
    top: -160px;
    border-radius: 50%;
    background: var(--color-sun);
    opacity: 0.55;
  }
  .page-hero--image::after { display: none; }
  .page-hero__grid { position: relative; z-index: 1; display: grid; grid-template-columns: 1fr; gap: 2rem 4rem; align-items: center; }
  .page-hero--image .page-hero__grid { grid-template-columns: 1.15fr 0.85fr; }
  .page-hero__copy { min-width: 0; max-width: 760px; }
  .page-hero h1 { font-size: clamp(2.1rem, 1.4rem + 2.8vw, 3.3rem); }
  .page-hero__intro { color: var(--color-muted); font-size: var(--text-lg); max-width: 40rem; }
  .page-hero__media { min-width: 0; }
  .page-hero__media img { width: 100%; aspect-ratio: 5 / 4; object-fit: cover; border-radius: var(--radius-lg) 120px var(--radius-lg) var(--radius-lg); box-shadow: var(--shadow-md); }
  .crumbs ol { display: flex; flex-wrap: wrap; align-items: center; gap: 0.35rem; margin: 0 0 1.25rem; padding: 0; list-style: none; font-size: var(--text-xs); font-weight: 600; }
  .crumbs li { display: inline-flex; align-items: center; gap: 0.35rem; color: var(--color-muted); }
  .crumbs a { color: var(--color-navy); text-decoration: none; }
  .crumbs a:hover { text-decoration: underline; }
  @media (max-width: 860px) { .page-hero--image .page-hero__grid { grid-template-columns: 1fr; } .page-hero__media { max-width: 520px; } }
</style>
