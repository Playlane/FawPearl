---
/** The ways to book: online scheduler, Zocdoc and the patient portal. */
import Icon from './Icon.astro';
import { site } from '../data/site';
const { scheduler, zocdoc, portal } = site.booking;
const options = [
  { ...scheduler, icon: 'calendar', primary: true },
  { ...zocdoc, icon: 'video', primary: false },
  { ...portal, icon: 'user', primary: false },
].filter((o) => o.url);
---

<div class="booking">
  {
    options.map((o) => (
      <a class:list={['booking__option', { 'booking__option--primary': o.primary }]} href={o.url} rel="noopener">
        <span class="booking__icon">
          <Icon name={o.icon} />
        </span>
        <span class="booking__text">
          <strong>{o.label}</strong>
          <span>{o.note}</span>
        </span>
        <Icon name="arrow-up-right" class="booking__go" />
      </a>
    ))
  }
</div>

<style>
  .booking { display: grid; gap: 0.75rem; }
  .booking__option {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 1rem;
    padding: 1.1rem 1.25rem;
    border: 1.5px solid var(--color-line);
    border-radius: var(--radius-md);
    background: #fff;
    color: var(--color-ink);
    text-decoration: none;
    transition: border-color 0.15s ease, box-shadow 0.15s ease, transform 0.15s ease;
  }
  .booking__option:hover { border-color: var(--color-navy); box-shadow: var(--shadow-md); transform: translateY(-2px); }
  .booking__icon { display: grid; place-items: center; width: 48px; height: 48px; border-radius: 50%; background: var(--color-sky); color: var(--color-navy); }
  .booking__text { display: grid; gap: 0.15rem; min-width: 0; }
  .booking__text strong { color: var(--color-navy-ink); font-size: var(--text-lg); }
  .booking__text span { color: var(--color-muted); font-size: var(--text-sm); }
  :global(.booking__go) { color: var(--color-navy); }
  .booking__option--primary { background: var(--color-navy); border-color: var(--color-navy); }
  .booking__option--primary .booking__icon { background: var(--color-sun); color: var(--color-navy-ink); }
  .booking__option--primary .booking__text strong { color: #fff; }
  .booking__option--primary .booking__text span { color: #cfe0f2; }
  .booking__option--primary :global(.booking__go) { color: var(--color-sun); }
</style>
