---
import Icon from './Icon.astro';
import { site } from '../data/site';

interface Props {
  title?: string;
  text?: string;
}
const {
  title = 'Meet with a provider as soon as this week',
  text = 'Take the first step toward a healthier mind. Book a secure video visit online in a few minutes, or request a callback and we will help you get started.',
} = Astro.props;
---

<section class="cta">
  <div class="container">
    <div class="cta__card" data-reveal>
      <div class="cta__shape cta__shape--a" aria-hidden="true"></div>
      <div class="cta__shape cta__shape--b" aria-hidden="true"></div>
      <div class="cta__copy">
        <h2>{title}</h2>
        <p>{text}</p>
      </div>
      <div class="cta__actions">
        <a class="btn btn--navy btn--lg" href="/book"><Icon name="calendar" />Book online now</a>
        <button class="btn btn--outline btn--lg" type="button" data-open-callback>Request a callback</button>
        <a class="cta__phone" href={`tel:${site.phone.tel}`}><Icon name="phone" size={18} />Or call {site.phone.display}</a>
      </div>
    </div>
  </div>
</section>

<style>
  .cta { padding-block: var(--section); }
  .cta__card {
    position: relative;
    overflow: hidden;
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: 2rem;
    align-items: center;
    padding: clamp(2rem, 5vw, 3.5rem);
    border-radius: var(--radius-lg);
    background: var(--color-sun);
  }
  .cta__shape { position: absolute; border-radius: 50%; pointer-events: none; }
  .cta__shape--a { width: 260px; height: 260px; right: -60px; top: -120px; background: rgba(255, 255, 255, 0.35); }
  .cta__shape--b { width: 180px; height: 180px; left: 38%; bottom: -110px; background: var(--color-turquoise); opacity: 0.45; }
  .cta__copy, .cta__actions { position: relative; }
  .cta h2 { font-size: var(--text-3xl); }
  .cta p { margin: 0; color: var(--color-navy-ink); font-size: var(--text-lg); }
  .cta__actions { display: grid; gap: 0.75rem; justify-items: stretch; }
  .cta__actions .btn--outline { background: rgba(255, 255, 255, 0.5); }
  .cta__phone { display: inline-flex; align-items: center; justify-content: center; gap: 0.4rem; color: var(--color-navy-ink); font-weight: 700; text-decoration: none; }
  @media (max-width: 860px) { .cta__card { grid-template-columns: 1fr; } }
</style>
