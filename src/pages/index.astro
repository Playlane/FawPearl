---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeHero from '../components/HomeHero.astro';
import CareFinder from '../components/CareFinder.astro';
import ConditionGrid from '../components/ConditionGrid.astro';
import Benefits from '../components/Benefits.astro';
import InsuranceBand from '../components/InsuranceBand.astro';
import ProviderCard from '../components/ProviderCard.astro';
import ServiceCard from '../components/ServiceCard.astro';
import Steps from '../components/Steps.astro';
import FaqList from '../components/FaqList.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import { services } from '../data/services';
import { careSettings, faqs } from '../data/content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
const dateFmt = new Intl.DateTimeFormat('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
---

<BaseLayout>
  <HomeHero />
  <CareFinder />
  <ConditionGrid />

  <section class="section section--alt">
    <div class="container split">
      <div class="split__media" data-reveal>
        <img src="/images/video-visit.jpg" alt="" width="1000" height="800" loading="lazy" />
        <p class="split__tag"><Icon name="lock" size={18} />Private, encrypted video</p>
      </div>
      <div class="split__copy" data-reveal>
        <p class="eyebrow">Virtual care</p>
        <h2>Care that fits into your life, not the other way around</h2>
        <p class="muted">
          Fawpearl Health Services provides compassionate, confidential and culturally competent psychiatric care by secure video.
          No commute and no waiting room: just a quiet space and a phone, tablet or computer.
        </p>
        <ul class="check-list">
          <li><Icon name="check" /><span>Same provider at every visit, so you never have to repeat your story</span></li>
          <li><Icon name="check" /><span>Evening and Saturday appointments</span></li>
          <li><Icon name="check" /><span>Prescriptions sent straight to your pharmacy</span></li>
        </ul>
        <div class="btn-row split__actions">
          <a class="btn btn--sun" href="/book">Book online now</a>
          <a class="link-arrow" href="/about">About Fawpearl <Icon name="arrow" /></a>
        </div>
      </div>
    </div>
    <div class="container benefits-wrap">
      <Benefits />
    </div>
  </section>

  <InsuranceBand />

  <section class="section">
    <div class="container">
      <header class="section-head">
        <p class="eyebrow">Our provider</p>
        <h2>Meet the provider behind your care</h2>
        <p>Every visit is with a licensed, board-certified Psychiatric Nurse Practitioner.</p>
      </header>
      <ProviderCard />
    </div>
  </section>

  <section class="section section--sky">
    <div class="container">
      <header class="section-head">
        <p class="eyebrow">Get care</p>
        <h2>Psychiatry, therapy and support</h2>
        <p>Clear self-pay rates for every visit. Start with an evaluation, then follow-ups that fit your plan.</p>
      </header>
      <div class="grid grid--3">
        {services.map((s) => <ServiceCard service={s} />)}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <header class="section-head">
        <p class="eyebrow">How it works</p>
        <h2>Our simple path to healing</h2>
      </header>
      <Steps />
    </div>
  </section>

  <section class="section section--sun">
    <div class="container split split--reverse">
      <div class="split__media" data-reveal>
        <img src="/images/home-setting.jpg" alt="" width="1200" height="750" loading="lazy" />
      </div>
      <div class="split__copy" data-reveal>
        <p class="eyebrow">Care settings</p>
        <h2>Care wherever you call home</h2>
        <p class="muted">
          We see patients at home and partner with care facilities to support their residents, coordinating with staff and families
          every step of the way.
        </p>
        <ul class="settings">
          {
            careSettings.map((c) => (
              <li>
                <a href={`/facilities#${c.id}`}>
                  <Icon name={c.icon} size={20} />
                  {c.name}
                </a>
              </li>
            ))
          }
        </ul>
        <div class="btn-row split__actions">
          <a class="btn btn--navy" href="/refer">Refer a patient</a>
          <a class="link-arrow" href="/facilities">Facility partnerships <Icon name="arrow" /></a>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container faq-layout">
      <header class="section-head section-head--left">
        <p class="eyebrow">FAQs</p>
        <h2>Questions before your first visit?</h2>
        <p>Quick answers about booking, insurance and visits.</p>
        <a class="link-arrow" href="/faqs">See all FAQs <Icon name="arrow" /></a>
      </header>
      <FaqList items={faqs.slice(0, 5)} openFirst />
    </div>
  </section>

  {
    posts.length > 0 && (
      <section class="section section--alt">
        <div class="container">
          <header class="section-head">
            <p class="eyebrow">From our blog</p>
            <h2>Read our latest articles</h2>
          </header>
          <div class="grid grid--3">
            {posts.map((post) => (
              <article class="post" data-reveal>
                <p class="post__meta">
                  <span class="chip">{post.data.category}</span>
                  <time datetime={post.data.date.toISOString()}>{dateFmt.format(post.data.date)}</time>
                </p>
                <h3>
                  <a href={`/blog/${post.id}`}>{post.data.title}</a>
                </h3>
                <p>{post.data.description}</p>
              </article>
            ))}
          </div>
          <p class="center">
            <a class="link-arrow" href="/blog">All articles <Icon name="arrow" /></a>
          </p>
        </div>
      </section>
    )
  }

  <CtaBand />
</BaseLayout>

<style>
  .split { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(2rem, 6vw, 5rem); align-items: center; }
  .split--reverse .split__media { order: 2; }
  .split__media { position: relative; min-width: 0; }
  .split__media img { width: 100%; aspect-ratio: 5 / 4; object-fit: cover; border-radius: var(--radius-lg); box-shadow: var(--shadow-md); }
  .split__tag {
    position: absolute;
    left: 1rem;
    bottom: 1rem;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin: 0;
    padding: 0.55rem 0.9rem;
    border-radius: var(--radius-pill);
    background: #fff;
    color: var(--color-navy-ink);
    font-size: var(--text-sm);
    font-weight: 700;
    box-shadow: var(--shadow-sm);
  }
  .split__copy { min-width: 0; }
  .split__copy .check-list { margin-block: 1.25rem 0; }
  .split__actions { align-items: center; gap: 1.25rem; margin-top: 1.75rem; }
  .benefits-wrap { margin-top: clamp(3rem, 6vw, 4.5rem); padding-top: clamp(2rem, 4vw, 3rem); border-top: 1px solid var(--color-line); }

  .settings { list-style: none; margin: 1.25rem 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .settings a {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.55rem 0.95rem;
    border-radius: var(--radius-pill);
    background: #fff;
    color: var(--color-navy-ink);
    font-size: var(--text-sm);
    font-weight: 650;
    text-decoration: none;
    box-shadow: var(--shadow-sm);
  }
  .settings a:hover { background: var(--color-navy); color: #fff; }
  .settings :global(svg) { color: var(--color-turquoise-deep); }
  .settings a:hover :global(svg) { color: var(--color-sun); }

  .faq-layout { display: grid; grid-template-columns: 0.8fr 1.2fr; gap: clamp(2rem, 5vw, 4rem); align-items: start; }
  .faq-layout .section-head p { margin-bottom: 1rem; }

  .post { position: relative; padding: 1.5rem; border-radius: var(--radius-md); background: #fff; border: 1px solid var(--color-line); transition: box-shadow 0.2s ease; }
  .post:hover { box-shadow: var(--shadow-md); }
  .post__meta { display: flex; align-items: center; gap: 0.75rem; color: var(--color-muted); font-size: var(--text-xs); font-weight: 600; }
  .post h3 { font-size: var(--text-lg); }
  .post h3 a { color: inherit; text-decoration: none; }
  .post h3 a::after { content: ''; position: absolute; inset: 0; }
  .post > p:last-child { margin: 0; color: var(--color-muted); font-size: var(--text-sm); }
  .center { margin: 2rem 0 0; text-align: center; }

  @media (max-width: 900px) {
    .split, .faq-layout { grid-template-columns: 1fr; }
    .split--reverse .split__media { order: 0; }
  }
</style>
