---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import ServiceCard from '../components/ServiceCard.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import { careSettings } from '../data/content';
import { services } from '../data/services';

const facilityServices = services.filter((s) =>
  ['psychiatric-evaluation', 'medication-management', 'crisis-consultation', 'behavioral-health-consultation', 'virtual-case-management'].includes(s.slug),
);
const partnerPoints = [
  'Psychiatric evaluations and medication management for residents',
  'Prompt consultations when symptoms escalate',
  'Guidance and practical strategies for your staff',
  'Coordination with primary care, pharmacies and families',
];
---

<BaseLayout title="Care settings" description="Virtual psychiatric care at home and for residential homes, group homes, assisted living and skilled nursing facilities.">
  <PageHero
    title="Care wherever you call home"
    eyebrow="Care settings"
    intro="We see patients at home by secure video and partner with care facilities to support their residents."
    crumbs={[{ label: 'Care settings' }]}
    image="/images/home-setting.jpg"
  >
    <div class="btn-row">
      <a class="btn btn--sun btn--lg" href="/refer">Refer a patient</a>
      <a class="btn btn--outline btn--lg" href="/book">Book for yourself</a>
    </div>
  </PageHero>

  <section class="section">
    <div class="container">
      <div class="settings">
        {
          careSettings.map((c) => (
            <article class="setting" id={c.id} data-reveal>
              <span class="icon-tile"><Icon name={c.icon} /></span>
              <h2>{c.name}</h2>
              <p>{c.text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--navy">
    <div class="container partner">
      <div>
        <p class="eyebrow">For facility partners</p>
        <h2>Psychiatric support your residents can count on</h2>
        <p class="partner__lead">We work alongside your team so residents get timely, consistent psychiatric care without leaving the building.</p>
        <a class="btn btn--sun btn--lg" href="/refer">Start a referral</a>
      </div>
      <ul class="partner__list">
        {partnerPoints.map((p) => <li><Icon name="check-circle" /><span>{p}</span></li>)}
      </ul>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <header class="section-head section-head--left">
        <h2>Services for residents and care teams</h2>
      </header>
      <div class="grid grid--3">
        {facilityServices.map((s) => <ServiceCard service={s} />)}
      </div>
    </div>
  </section>

  <CtaBand title="Set up psychiatric services for your facility" text="Tell us about your residents and your team. We'll arrange an intake call and a plan that fits your schedule." />
</BaseLayout>

<style>
  .settings { display: grid; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); gap: 1.25rem; }
  .setting { padding: 1.5rem; border-radius: var(--radius-md); background: var(--color-sky); scroll-margin-top: calc(var(--header-h) + 24px); }
  .setting:nth-child(even) { background: var(--color-sun-soft); }
  .setting .icon-tile { background: #fff; margin-bottom: 1rem; }
  .setting h2 { font-size: var(--text-lg); }
  .setting p { margin: 0; color: var(--color-muted); font-size: var(--text-sm); }
  .partner { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(2rem, 5vw, 4rem); align-items: center; }
  .partner__lead { color: #cfe0f2; font-size: var(--text-lg); margin-bottom: 1.75rem; }
  .partner__list { list-style: none; margin: 0; padding: 0; display: grid; gap: 1rem; }
  .partner__list li { display: flex; gap: 0.75rem; align-items: flex-start; padding: 1rem 1.1rem; border-radius: var(--radius-md); background: rgba(255, 255, 255, 0.07); font-weight: 600; }
  .partner__list :global(svg) { flex: none; color: var(--color-sun); }
  @media (max-width: 860px) { .partner { grid-template-columns: 1fr; } }
</style>
