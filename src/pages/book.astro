---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import BookingOptions from '../components/BookingOptions.astro';
import Icon from '../components/Icon.astro';
import { services, firstVisit } from '../data/services';
import { site } from '../data/site';
---

<BaseLayout title="Book online" description="Choose your visit type and book a secure video appointment with Fawpearl Health Services.">
  <PageHero
    title="Book your visit"
    eyebrow="Book online"
    intro="Choose the type of visit you need, then pick a time in our online scheduler. All visits take place by secure video."
    crumbs={[{ label: 'Book online' }]}
  />

  <section class="section book" data-book data-states={JSON.stringify(site.statesServed)}>
    <div class="container book__grid">
      <div class="book__main">
        <div class="step">
          <span class="step__num">1</span>
          <div>
            <h2>Choose your visit</h2>
            <p class="muted">New patients start with an {firstVisit.name}.</p>
          </div>
        </div>

        <fieldset class="visits">
          <legend class="visually-hidden">Visit type</legend>
          {
            services.map((s) => (
              <label class="visit">
                <input type="radio" name="visit" value={s.slug} data-name={s.name} data-price={s.price} checked={s.slug === firstVisit.slug} />
                <span class="visit__card">
                  <span class="icon-tile">
                    <Icon name={s.icon} />
                  </span>
                  <span class="visit__text">
                    <strong>
                      {s.name}
                      {s.firstVisit && <span class="chip">New patients</span>}
                    </strong>
                    <span>{s.short}</span>
                  </span>
                  <span class="visit__price">${s.price}</span>
                </span>
              </label>
            ))
          }
        </fieldset>

        <div class="step">
          <span class="step__num">2</span>
          <div>
            <h2>Pick a time</h2>
            <p class="muted"><strong data-summary>{firstVisit.name} · ${firstVisit.price}</strong> · secure video visit</p>
          </div>
        </div>

        <p class="notice" hidden data-notice="state"></p>
        <p class="notice" hidden data-notice="insurance">
          <Icon name="shield" size={20} />
          <span>Using insurance? <button class="text-btn" type="button" data-open-callback>Request a callback</button> and we'll check your coverage before your visit.</span>
        </p>
        <p class="notice" hidden data-notice="facility">
          <Icon name="building" size={20} />
          <span>Booking for a facility resident? <a href="/refer">Use our referral form</a> or call {site.phone.display} and we'll arrange an intake with your team.</span>
        </p>

        <BookingOptions />
      </div>

      <aside class="book__aside">
        <div class="aside-card">
          <h3>What happens next</h3>
          <ol class="next">
            <li>Pick a time in our scheduler and complete the short intake form.</li>
            <li>You receive a confirmation with your secure video link.</li>
            <li>Join from your phone, tablet or computer at your appointment time.</li>
          </ol>
        </div>
        <div class="aside-card">
          <h3>Prefer to talk first?</h3>
          <p>We're happy to help you choose the right visit.</p>
          <div class="aside-actions">
            <a class="btn btn--outline btn--block" href={`tel:${site.phone.tel}`}><Icon name="phone" />{site.phone.display}</a>
            <button class="btn btn--sun btn--block" type="button" data-open-callback>Request a callback</button>
          </div>
        </div>
        <p class="crisis"><Icon name="shield" size={18} /><span>{site.crisis}</span></p>
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  .book__grid { display: grid; grid-template-columns: 1.6fr 1fr; gap: clamp(2rem, 4vw, 3.5rem); align-items: start; }
  .book__main { min-width: 0; }
  .step { display: flex; gap: 1rem; align-items: flex-start; margin-bottom: 1.25rem; }
  .step:not(:first-child) { margin-top: 2.75rem; }
  .step h2 { margin-bottom: 0.15rem; font-size: var(--text-2xl); }
  .step p { margin: 0; }
  .step__num { display: grid; place-items: center; flex: none; width: 44px; height: 44px; border-radius: 50%; background: var(--color-navy); color: #fff; font-weight: 800; }

  .visits { border: 0; margin: 0; padding: 0; display: grid; gap: 0.7rem; }
  .visit input { position: absolute; opacity: 0; pointer-events: none; }
  .visit__card {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 1rem;
    align-items: center;
    padding: 1rem 1.2rem;
    border: 1.5px solid var(--color-line);
    border-radius: var(--radius-md);
    background: #fff;
    cursor: pointer;
    transition: border-color 0.15s ease, box-shadow 0.15s ease, background 0.15s ease;
  }
  .visit:hover .visit__card { border-color: var(--color-turquoise); }
  .visit input:checked + .visit__card { border-color: var(--color-navy); background: var(--color-sky); box-shadow: 0 0 0 3px var(--color-sky-strong); }
  .visit input:focus-visible + .visit__card { outline: 3px solid var(--color-turquoise-deep); outline-offset: 2px; }
  .visit__text { display: grid; gap: 0.2rem; min-width: 0; }
  .visit__text strong { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem; color: var(--color-navy-ink); }
  .visit__text > span { color: var(--color-muted); font-size: var(--text-sm); }
  .visit__price { color: var(--color-navy-ink); font-size: var(--text-xl); font-weight: 800; font-variant-numeric: tabular-nums; }
  .visit .chip { background: var(--color-sun); color: var(--color-navy-ink); }

  .notice {
    display: flex;
    gap: 0.6rem;
    align-items: flex-start;
    margin: 0 0 1rem;
    padding: 0.9rem 1rem;
    border-radius: var(--radius-sm);
    background: var(--color-warning-bg);
    color: var(--color-navy-ink);
    font-size: var(--text-sm);
  }
  .notice[hidden] { display: none; }
  .notice :global(svg) { flex: none; color: var(--color-navy); }
  .text-btn { padding: 0; border: 0; background: none; color: var(--color-navy); font: inherit; font-weight: 700; text-decoration: underline; cursor: pointer; }

  .book__aside { display: grid; gap: 1rem; position: sticky; top: calc(var(--header-h) + 1.5rem); min-width: 0; }
  .aside-card { padding: 1.5rem; border-radius: var(--radius-md); background: var(--color-surface-alt); }
  .aside-card h3 { font-size: var(--text-lg); }
  .aside-card p { color: var(--color-muted); font-size: var(--text-sm); }
  .aside-actions { display: grid; gap: 0.6rem; }
  .next { margin: 0; padding: 0; list-style: none; counter-reset: n; display: grid; gap: 0.8rem; }
  .next li { counter-increment: n; display: grid; grid-template-columns: 28px 1fr; gap: 0.7rem; color: var(--color-muted); font-size: var(--text-sm); }
  .next li::before { content: counter(n); display: grid; place-items: center; width: 28px; height: 28px; border-radius: 50%; background: var(--color-sun); color: var(--color-navy-ink); font-weight: 800; font-size: var(--text-xs); }
  .crisis { display: flex; gap: 0.5rem; margin: 0; padding-left: 0.25rem; color: var(--color-muted); font-size: var(--text-xs); }
  .crisis :global(svg) { flex: none; color: var(--color-navy); }

  @media (max-width: 960px) {
    .book__grid { grid-template-columns: 1fr; }
    .book__aside { position: static; }
  }
  @media (max-width: 520px) {
    .visit__card { grid-template-columns: auto 1fr; }
    .visit__price { grid-column: 2; font-size: var(--text-lg); }
  }
</style>

<script>
  import { states } from '../data/states';

  const root = document.querySelector<HTMLElement>('[data-book]');
  if (root) {
    const params = new URLSearchParams(window.location.search);
    const radios = Array.from(root.querySelectorAll<HTMLInputElement>('input[name="visit"]'));
    const summary = root.querySelector<HTMLElement>('[data-summary]');
    const notice = (name: string) => root.querySelector<HTMLElement>(`[data-notice="${name}"]`);

    const updateSummary = () => {
      const chosen = radios.find((r) => r.checked);
      if (chosen && summary) summary.textContent = `${chosen.dataset.name} · $${chosen.dataset.price}`;
    };

    // Pre-select the visit chosen in the care finder or a "Book" link.
    const care = params.get('care');
    const match = radios.find((r) => r.value === care);
    if (match) match.checked = true;
    radios.forEach((r) => r.addEventListener('change', updateSummary));
    updateSummary();

    if (params.get('pay') === 'insurance') notice('insurance')?.removeAttribute('hidden');
    if (care === 'facility' || params.get('for') === 'resident') notice('facility')?.removeAttribute('hidden');

    const served: string[] = JSON.parse(root.dataset.states ?? '[]');
    const state = params.get('state');
    const stateNotice = notice('state');
    if (state && served.length && !served.includes(state) && stateNotice) {
      const name = states.find((s) => s.code === state)?.name ?? state;
      stateNotice.textContent = `We're not yet able to see patients in ${name}. Request a callback and we'll let you know when that changes.`;
      stateNotice.removeAttribute('hidden');
    }
  }
</script>
