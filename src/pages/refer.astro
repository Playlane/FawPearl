---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';
import { careSettings } from '../data/content';
import { services } from '../data/services';
---

<BaseLayout title="Refer a patient" description="Refer a patient, family member or facility resident to Fawpearl Health Services for psychiatric care.">
  <PageHero
    title="Refer a patient"
    eyebrow="For families, providers and facilities"
    intro="Tell us who needs support and how to reach you. We'll contact you within one business day to arrange an intake."
    crumbs={[{ label: 'Refer a patient' }]}
  />

  <section class="section">
    <div class="container refer">
      <form class="refer__form" action={site.formEndpoint} method="post" data-form="referral" data-success="Thank you. We'll contact you within one business day to arrange an intake.">
        <div class="hp" aria-hidden="true"><label for="rf-company">Company</label><input id="rf-company" name="company" tabindex="-1" autocomplete="off" /></div>

        <h2>About you</h2>
        <div class="row">
          <div class="field"><label for="rf-name">Your name</label><input class="input" id="rf-name" name="name" autocomplete="name" required /></div>
          <div class="field"><label for="rf-org">Facility or organization (optional)</label><input class="input" id="rf-org" name="organization" autocomplete="organization" /></div>
        </div>
        <div class="row">
          <div class="field"><label for="rf-email">Email</label><input class="input" id="rf-email" name="email" type="email" autocomplete="email" required /></div>
          <div class="field"><label for="rf-phone">Phone</label><input class="input" id="rf-phone" name="phone" type="tel" autocomplete="tel" required /></div>
        </div>
        <div class="field">
          <label for="rf-role">Your relationship to the patient</label>
          <select class="select" id="rf-role" name="role">
            <option>Family member or friend</option>
            <option>Facility staff</option>
            <option>Case manager or social worker</option>
            <option>Healthcare provider</option>
            <option>Other</option>
          </select>
        </div>

        <h2>About the referral</h2>
        <div class="row">
          <div class="field">
            <label for="rf-setting">Care setting</label>
            <select class="select" id="rf-setting" name="setting">
              {careSettings.map((c) => <option>{c.name}</option>)}
            </select>
          </div>
          <div class="field">
            <label for="rf-service">Type of care needed</label>
            <select class="select" id="rf-service" name="service">
              {services.map((s) => <option>{s.name}</option>)}
              <option>Not sure</option>
            </select>
          </div>
        </div>
        <div class="field">
          <label for="rf-notes">Anything else we should know?</label>
          <textarea class="textarea" id="rf-notes" name="message" placeholder="Please share only what we need to get in touch. We'll collect health details securely during intake."></textarea>
        </div>
        <label class="consent">
          <input type="checkbox" name="consent" value="yes" required id="rf-consent" />
          <span>I agree to be contacted about this referral. See our <a href={site.legal.privacyUrl}>privacy policy</a>.</span>
        </label>
        <button class="btn btn--sun btn--lg" type="submit">Send referral</button>
        <p class="form-status" role="status" hidden data-form-status></p>
      </form>

      <aside class="refer__aside">
        <div class="aside-card">
          <h3>What happens next</h3>
          <ol class="next">
            <li>We review your referral and contact you within one business day.</li>
            <li>We schedule an intake and gather health information securely.</li>
            <li>Care begins by secure video at home or in the facility.</li>
          </ol>
        </div>
        <div class="aside-card">
          <h3>Prefer to call?</h3>
          <p><a class="link-arrow" href={`tel:${site.phone.tel}`}><Icon name="phone" />{site.phone.display}</a></p>
          <p><a class="link-arrow" href={`mailto:${site.email}`}><Icon name="mail" />{site.email}</a></p>
        </div>
        <p class="crisis"><Icon name="shield" size={18} /><span>{site.crisis}</span></p>
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  .refer { display: grid; grid-template-columns: 1.5fr 1fr; gap: clamp(2rem, 5vw, 4rem); align-items: start; }
  .refer__form { display: grid; gap: 1rem; padding: clamp(1.25rem, 3vw, 2.25rem); border: 1px solid var(--color-line); border-radius: var(--radius-lg); box-shadow: var(--shadow-md); min-width: 0; }
  .refer__form h2 { margin: 0.5rem 0 0; font-size: var(--text-xl); }
  .row { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  .consent { display: flex; gap: 0.6rem; align-items: flex-start; color: var(--color-muted); font-size: var(--text-sm); }
  .consent input { width: 18px; height: 18px; margin-top: 0.2rem; accent-color: var(--color-navy); flex: none; }
  .refer__form .btn { justify-self: start; }
  .refer__aside { display: grid; gap: 1rem; min-width: 0; }
  .aside-card { padding: 1.5rem; border-radius: var(--radius-md); background: var(--color-surface-alt); }
  .aside-card h3 { font-size: var(--text-lg); }
  .aside-card p { margin: 0.4rem 0 0; }
  .next { margin: 0; padding: 0; list-style: none; counter-reset: n; display: grid; gap: 0.8rem; }
  .next li { counter-increment: n; display: grid; grid-template-columns: 28px 1fr; gap: 0.7rem; color: var(--color-muted); font-size: var(--text-sm); }
  .next li::before { content: counter(n); display: grid; place-items: center; width: 28px; height: 28px; border-radius: 50%; background: var(--color-sun); color: var(--color-navy-ink); font-weight: 800; font-size: var(--text-xs); }
  .crisis { display: flex; gap: 0.5rem; margin: 0; color: var(--color-muted); font-size: var(--text-xs); }
  .crisis :global(svg) { flex: none; color: var(--color-navy); }
  @media (max-width: 900px) { .refer { grid-template-columns: 1fr; } }
  @media (max-width: 560px) { .row { grid-template-columns: 1fr; } }
</style>
