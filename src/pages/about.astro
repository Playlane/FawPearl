---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import ProviderCard from '../components/ProviderCard.astro';
import Steps from '../components/Steps.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import { mission, vision, values } from '../data/content';
---

<BaseLayout title="About us" description="Fawpearl Health Services provides compassionate, confidential and culturally competent virtual mental health care.">
  <PageHero
    title="Compassionate care, wherever you are"
    eyebrow="About Fawpearl"
    intro="Fawpearl Health Services provides client-centered virtual mental health care: compassionate, confidential and culturally competent."
    crumbs={[{ label: 'About' }]}
    image="/images/calm.jpg"
  />

  <section class="section">
    <div class="container mv">
      <div class="mv__card">
        <p class="eyebrow">Our mission</p>
        <p class="mv__text">{mission}</p>
      </div>
      <div class="mv__card mv__card--navy">
        <p class="eyebrow">Our vision</p>
        <p class="mv__text">{vision}</p>
      </div>
    </div>
  </section>

  <section class="section section--sky">
    <div class="container">
      <header class="section-head">
        <p class="eyebrow">What guides us</p>
        <h2>Our values</h2>
      </header>
      <div class="grid grid--4">
        {
          values.map((v) => (
            <article class="value" data-reveal>
              <span class="icon-tile"><Icon name={v.icon} /></span>
              <h3>{v.title}</h3>
              <p>{v.text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <header class="section-head"><p class="eyebrow">Our provider</p><h2>Meet Abimbola</h2></header>
      <ProviderCard />
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <header class="section-head"><p class="eyebrow">How it works</p><h2>Our simple path to healing</h2></header>
      <Steps />
    </div>
  </section>

  <CtaBand />
</BaseLayout>

<style>
  .mv { display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem; }
  .mv__card { padding: clamp(1.75rem, 4vw, 2.75rem); border-radius: var(--radius-lg); background: var(--color-sun-soft); }
  .mv__card--navy { background: var(--color-navy); }
  .mv__card--navy .eyebrow { color: var(--color-turquoise); }
  .mv__text { margin: 0; color: var(--color-navy-ink); font-size: clamp(1.3rem, 1rem + 1vw, 1.7rem); font-weight: 700; line-height: 1.35; letter-spacing: -0.015em; }
  .mv__card--navy .mv__text { color: #fff; }
  .value { padding: 1.5rem; border-radius: var(--radius-md); background: #fff; }
  .value .icon-tile { margin-bottom: 1rem; background: var(--color-sun-soft); }
  .value h3 { font-size: var(--text-lg); }
  .value p { margin: 0; color: var(--color-muted); font-size: var(--text-sm); }
  @media (max-width: 760px) { .mv { grid-template-columns: 1fr; } }
</style>
