---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import ConditionGrid from '../../components/ConditionGrid.astro';
import CtaBand from '../../components/CtaBand.astro';
---

<BaseLayout title="Conditions we treat" description="Depression, anxiety, trauma and more: learn how Fawpearl Health Services can help.">
  <PageHero
    title="Conditions we treat"
    eyebrow="Get care"
    intro="Compassionate, evidence-based care for the challenges that affect your mood, sleep, focus and relationships."
    crumbs={[{ label: 'Get care', href: '/services' }, { label: 'Conditions' }]}
  />
  <ConditionGrid title="Choose a topic" intro="Learn about common signs and how treatment at Fawpearl can help." />
  <CtaBand />
</BaseLayout>
