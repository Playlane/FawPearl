---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import { site, hoursText } from '../data/site';
---

<BaseLayout title="Contact us" description="Call, email or message Fawpearl Health Services. We reply within one business day.">
  <PageHero
    title="Get in touch"
    eyebrow="Contact"
    intro="Every small step counts. Reach out and we'll walk with you through the next one."
    crumbs={[{ label: 'Contact' }]}
  />

  <section class="section">
    <div class="container contact">
      <form class="contact__form" action={site.formEndpoint} method="post" data-form="contact" data-success="Thank you. We'll reply within one business day.">
        <div class="hp" aria-hidden="true"><label for="ct-company">Company</label><input id="ct-company" name="company" tabindex="-1" autocomplete="off" /></div>
        <h2>Send us a message</h2>
        <p class="muted">We reply within one business day. Please don't include detailed medical information.</p>
        <div class="row">
          <div class="field"><label for="ct-name">Name</label><input class="input" id="ct-name" name="name" autocomplete="name" required /></div>
          <div class="field"><label for="ct-phone">Phone</label><input class="input" id="ct-phone" name="phone" type="tel" autocomplete="tel" /></div>
        </div>
        <div class="field"><label for="ct-email">Email</label><input class="input" id="ct-email" name="email" type="email" autocomplete="email" required /></div>
        <div class="field"><label for="ct-message">Message</label><textarea class="textarea" id="ct-message" name="message" required></textarea></div>
        <label class="consent">
          <input type="checkbox" name="consent" value="yes" required id="ct-consent" />
          <span>I agree to be contacted by phone, text or email. See our <a href={site.legal.privacyUrl}>privacy policy</a>.</span>
        </label>
        <button class="btn btn--sun btn--lg" type="submit">Send message</button>
        <p class="form-status" role="status" hidden data-form-status></p>
      </form>

      <aside class="contact__aside">
        <ul class="ways">
          <li><span class="icon-tile"><Icon name="phone" /></span><span><small>Call</small><a href={`tel:${site.phone.tel}`}>{site.phone.display}</a></span></li>
          <li><span class="icon-tile"><Icon name="mail" /></span><span><small>Email</small><a href={`mailto:${site.email}`}>{site.email}</a></span></li>
          <li><span class="icon-tile"><Icon name="user" /></span><span><small>Existing patients</small><a href={site.booking.portal.url}>Patient portal</a></span></li>
          <li><span class="icon-tile"><Icon name="video" /></span><span><small>Visits</small>Secure video, at home or your facility</span></li>
        </ul>
        <div class="hours">
          <h3>Hours (Eastern time)</h3>
          <dl>
            {site.hours.map((h) => <div><dt>{h.label}</dt><dd>{hoursText(h)}</dd></div>)}
          </dl>
        </div>
        <p class="crisis"><Icon name="shield" size={18} /><span>{site.crisis}</span></p>
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  .contact { display: grid; grid-template-columns: 1.4fr 1fr; gap: clamp(2rem, 5vw, 4rem); align-items: start; }
  .contact__form { display: grid; gap: 1rem; padding: clamp(1.25rem, 3vw, 2.25rem); border: 1px solid var(--color-line); border-radius: var(--radius-lg); box-shadow: var(--shadow-md); min-width: 0; }
  .contact__form h2 { margin: 0; font-size: var(--text-2xl); }
  .contact__form > p.muted { margin: 0; }
  .row { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  .consent { display: flex; gap: 0.6rem; align-items: flex-start; color: var(--color-muted); font-size: var(--text-sm); }
  .consent input { width: 18px; height: 18px; margin-top: 0.2rem; accent-color: var(--color-navy); flex: none; }
  .contact__form .btn { justify-self: start; }
  .contact__aside { display: grid; gap: 1.5rem; min-width: 0; }
  .ways { list-style: none; margin: 0; padding: 0; display: grid; gap: 1rem; }
  .ways li { display: flex; gap: 0.9rem; align-items: center; }
  .ways small { display: block; color: var(--color-muted); font-size: var(--text-xs); font-weight: 650; letter-spacing: 0.06em; text-transform: uppercase; }
  .ways a { color: var(--color-navy-ink); font-weight: 700; text-decoration: none; overflow-wrap: anywhere; }
  .hours { padding: 1.4rem; border-radius: var(--radius-md); background: var(--color-sky); }
  .hours h3 { font-size: var(--text-lg); }
  .hours dl { margin: 0; display: grid; gap: 0.4rem; }
  .hours div { display: flex; justify-content: space-between; gap: 1rem; padding-bottom: 0.4rem; border-bottom: 1px solid var(--color-sky-strong); }
  .hours div:last-child { border: 0; padding: 0; }
  .hours dt { font-weight: 650; color: var(--color-navy-ink); }
  .hours dd { margin: 0; color: var(--color-muted); font-variant-numeric: tabular-nums; }
  .crisis { display: flex; gap: 0.5rem; margin: 0; color: var(--color-muted); font-size: var(--text-xs); }
  .crisis :global(svg) { flex: none; color: var(--color-navy); }
  @media (max-width: 900px) { .contact { grid-template-columns: 1fr; } }
  @media (max-width: 560px) { .row { grid-template-columns: 1fr; } }
</style>
