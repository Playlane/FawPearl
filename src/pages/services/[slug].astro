---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import CtaBand from '../../components/CtaBand.astro';
import Icon from '../../components/Icon.astro';
import { services, categories, type Service } from '../../data/services';
import { site } from '../../data/site';

export function getStaticPaths() {
  return services.map((service) => ({ params: { slug: service.slug }, props: { service } }));
}

interface Props {
  service: Service;
}
const { service } = Astro.props;
const related = services.filter((s) => s.slug !== service.slug).slice(0, 3);
---

<BaseLayout title={service.name} description={service.short}>
  <PageHero
    title={service.name}
    eyebrow={categories[service.category].label}
    intro={service.intro}
    crumbs={[{ label: 'Get care', href: '/services' }, { label: service.name }]}
  >
    <div class="btn-row">
      <a class="btn btn--sun btn--lg" href={`/book?care=${service.slug}`}>Book this visit</a>
      <a class="btn btn--outline btn--lg" href={`tel:${site.phone.tel}`}><Icon name="phone" />{site.phone.display}</a>
    </div>
  </PageHero>

  <section class="section">
    <div class="container detail">
      <div class="detail__main">
        <h2>What to expect</h2>
        <ul class="check-list">
          {service.expect.map((item) => <li><Icon name="check" /><span>{item}</span></li>)}
        </ul>
        <h2 class="detail__h2">A good fit for</h2>
        <ul class="fit">
          {service.goodFor.map((item) => <li class="chip">{item}</li>)}
        </ul>
      </div>
      <aside class="detail__card">
        <span class="icon-tile"><Icon name={service.icon} /></span>
        <p class="detail__price">${service.price}<span> per session, self-pay</span></p>
        <ul class="detail__facts">
          <li><Icon name="video" size={18} />Secure video visit</li>
          <li><Icon name="shield" size={18} />Insurance coverage checked on request</li>
          <li><Icon name="clock" size={18} />Evening &amp; Saturday times</li>
        </ul>
        <a class="btn btn--sun btn--block" href={`/book?care=${service.slug}`}>Book this visit</a>
        <a class="link-arrow" href="/insurance">Insurance &amp; pricing <Icon name="arrow" /></a>
      </aside>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <header class="section-head section-head--left">
        <h2>Other services</h2>
      </header>
      <div class="grid grid--3">
        {related.map((s) => <ServiceCard service={s} />)}
      </div>
    </div>
  </section>

  <CtaBand />
</BaseLayout>

<style>
  .detail { display: grid; grid-template-columns: 1.5fr 1fr; gap: clamp(2rem, 5vw, 4rem); align-items: start; }
  .detail__main { min-width: 0; }
  .detail__main h2 { font-size: var(--text-2xl); }
  .detail__h2 { margin-top: 2.5rem; }
  .fit { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .fit .chip { font-size: var(--text-sm); padding: 0.5rem 0.95rem; }
  .detail__card { display: grid; gap: 1rem; padding: 1.75rem; border-radius: var(--radius-lg); background: #fff; border: 1px solid var(--color-line); box-shadow: var(--shadow-md); position: sticky; top: calc(var(--header-h) + 1.5rem); }
  .detail__price { margin: 0; color: var(--color-navy-ink); font-size: 2.4rem; font-weight: 800; letter-spacing: -0.03em; line-height: 1; }
  .detail__price span { display: block; margin-top: 0.4rem; color: var(--color-muted); font-size: var(--text-sm); font-weight: 600; letter-spacing: 0; }
  .detail__facts { list-style: none; margin: 0; padding: 1rem 0; border-block: 1px solid var(--color-line); display: grid; gap: 0.55rem; font-size: var(--text-sm); }
  .detail__facts li { display: flex; align-items: center; gap: 0.55rem; }
  .detail__facts :global(svg) { color: var(--color-turquoise-deep); }
  @media (max-width: 860px) { .detail { grid-template-columns: 1fr; } .detail__card { position: static; } }
</style>
