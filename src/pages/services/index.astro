---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import CareFinder from '../../components/CareFinder.astro';
import CtaBand from '../../components/CtaBand.astro';
import { categories, servicesBy, type ServiceCategory } from '../../data/services';

const order: ServiceCategory[] = ['psychiatry', 'therapy', 'support'];
---

<BaseLayout title="Get care" description="Psychiatric evaluations, medication management, virtual therapy and care coordination from Fawpearl Health Services.">
  <PageHero
    title="Get care"
    eyebrow="Services"
    intro="Psychiatry, therapy and support for individuals, families and care teams, all by secure video."
    crumbs={[{ label: 'Get care' }]}
    image="/images/wellness.jpg"
  >
    <div class="btn-row">
      <a class="btn btn--sun btn--lg" href="/book">Book online now</a>
      <button class="btn btn--outline btn--lg" type="button" data-open-callback>Request a callback</button>
    </div>
  </PageHero>

  {
    order.map((cat, i) => (
      <section class:list={['section', { 'section--alt': i % 2 === 1 }]} id={cat}>
        <div class="container">
          <header class="section-head section-head--left">
            <h2>{categories[cat].label}</h2>
            <p>{categories[cat].blurb}</p>
          </header>
          <div class="grid grid--3">
            {servicesBy(cat).map((s) => (
              <ServiceCard service={s} />
            ))}
          </div>
        </div>
      </section>
    ))
  }

  <CareFinder overlap={false} />
  <CtaBand />
</BaseLayout>
