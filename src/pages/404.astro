---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
---

<BaseLayout title="Page not found">
  <PageHero title="We couldn't find that page" eyebrow="404" intro="The page may have moved. You can book a visit, explore our services or head back home.">
    <div class="btn-row">
      <a class="btn btn--sun btn--lg" href="/book">Book online now</a>
      <a class="btn btn--outline btn--lg" href="/services">Get care</a>
      <a class="btn btn--outline btn--lg" href="/">Home</a>
    </div>
  </PageHero>
</BaseLayout>
