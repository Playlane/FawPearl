---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import { services } from '../data/services';
import { site } from '../data/site';
---

<BaseLayout title="Insurance & pricing" description="Self-pay rates for every visit type, help checking your insurance coverage, and payment policies.">
  <PageHero
    title="Insurance & pricing"
    eyebrow="Paying for care"
    intro="Clear self-pay rates, no membership fees, and help checking your insurance coverage before your first visit."
    crumbs={[{ label: 'Insurance & pricing' }]}
  />

  <section class="section" id="rates">
    <div class="container pricing">
      <div class="rates">
        <h2>Self-pay rates</h2>
        <div class="table-wrap">
          <table>
            <thead><tr><th scope="col">Visit</th><th scope="col">Per session</th><th scope="col"><span class="visually-hidden">Book</span></th></tr></thead>
            <tbody>
              {
                services.map((s) => (
                  <tr>
                    <td>
                      <a href={`/services/${s.slug}`}>{s.name}</a>
                      <small>{s.short}</small>
                    </td>
                    <td class="price">${s.price}</td>
                    <td><a class="btn btn--outline" href={`/book?care=${s.slug}&pay=self-pay`}>Book</a></td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </div>

      <aside class="side">
        <div class="side__card side__card--navy" id="insurance">
          <Icon name="shield" size={32} />
          <h3>Using insurance?</h3>
          {
            site.insurance.plans.length > 0 && (
              <ul class="plans">
                {site.insurance.plans.map((p) => (
                  <li>{p}</li>
                ))}
              </ul>
            )
          }
          <p>{site.insurance.note}</p>
          <button class="btn btn--sun btn--block" type="button" data-open-callback>Check my coverage</button>
        </div>
        <div class="side__card" id="policies">
          <h3>Payment policies</h3>
          <ul class="check-list">
            {site.payment.map((p) => <li><Icon name="check" /><span>{p}</span></li>)}
          </ul>
        </div>
      </aside>
    </div>
  </section>

  <CtaBand />
</BaseLayout>

<style>
  .pricing { display: grid; grid-template-columns: 1.6fr 1fr; gap: clamp(2rem, 5vw, 4rem); align-items: start; }
  .rates { min-width: 0; }
  .rates h2 { font-size: var(--text-2xl); }
  .table-wrap { position: relative; overflow-x: auto; border: 1px solid var(--color-line); border-radius: var(--radius-md); }
  table { width: 100%; border-collapse: collapse; min-width: 480px; }
  th { padding: 0.9rem 1.1rem; background: var(--color-surface-alt); text-align: left; font-size: var(--text-xs); letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-muted); }
  td { padding: 1.1rem; border-top: 1px solid var(--color-line); vertical-align: middle; }
  td a:not(.btn) { color: var(--color-navy-ink); font-weight: 700; text-decoration: none; }
  td a:not(.btn):hover { text-decoration: underline; }
  td small { display: block; color: var(--color-muted); font-size: var(--text-xs); margin-top: 0.2rem; }
  .price { color: var(--color-navy-ink); font-size: var(--text-xl); font-weight: 800; font-variant-numeric: tabular-nums; white-space: nowrap; }
  td .btn { min-height: 40px; padding: 0.5rem 1rem; }
  .side { display: grid; gap: 1rem; min-width: 0; }
  .side__card { padding: 1.6rem; border-radius: var(--radius-lg); background: var(--color-surface-alt); scroll-margin-top: calc(var(--header-h) + 24px); }
  .side__card h3 { font-size: var(--text-xl); }
  .side__card--navy { background: var(--color-navy); color: #dbe8f5; }
  .side__card--navy h3 { color: #fff; margin-top: 0.75rem; }
  .side__card--navy :global(svg) { color: var(--color-sun); }
  .plans { list-style: none; margin: 0 0 1rem; padding: 0; display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .plans li { padding: 0.35rem 0.75rem; border-radius: var(--radius-pill); background: #fff; color: var(--color-navy-ink); font-size: var(--text-xs); font-weight: 650; }
  @media (max-width: 900px) { .pricing { grid-template-columns: 1fr; } }
  @media (max-width: 560px) {
    table { min-width: 0; }
    th:last-child, td:last-child { display: none; }
  }
</style>
