---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import ProviderCard from '../components/ProviderCard.astro';
import Benefits from '../components/Benefits.astro';
import CtaBand from '../components/CtaBand.astro';
import { provider } from '../data/site';
---

<BaseLayout title={`${provider.name}, ${provider.credentials}`} description={`${provider.name}, ${provider.title}. ${provider.summary}`}>
  <PageHero
    title="Our provider"
    eyebrow="Find a provider"
    intro="Every visit at Fawpearl is with a licensed, board-certified Psychiatric Nurse Practitioner who gets to know you and your goals."
    crumbs={[{ label: 'Our provider' }]}
  />
  <section class="section">
    <div class="container">
      <ProviderCard full />
    </div>
  </section>
  <section class="section section--alt">
    <div class="container">
      <header class="section-head"><h2>Why patients choose Fawpearl</h2></header>
      <Benefits />
    </div>
  </section>
  <CtaBand title={`Book with ${provider.name.split(' ')[0]}`} />
</BaseLayout>
